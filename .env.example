# growworks 공개 API 연동 설정
# 테넌트 slug — 전 경로 고정값
SITE_SLUG=cwc

# 서버(SSR/ISR) 페치용 — 게시판·설정·문의
API_BASE_URL=https://api.growworks.co.kr

# 브라우저 직접 호출용 — 회원 인증(rate limit 이 IP 단위라 서버 프록시 금지)
NEXT_PUBLIC_API_BASE_URL=https://api.growworks.co.kr

# 사이트 절대 URL (메타·sitemap)
NEXT_PUBLIC_SITE_URL=https://coach.cwc.or.kr

# 카카오맵 JavaScript 키 (오시는 길 지도 — 콘솔에 사이트 도메인 등록 필요)
NEXT_PUBLIC_KAKAO_MAP_KEY=b17dcccbfd909891fae73d3a6ae9514c
